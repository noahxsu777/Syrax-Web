SECRETS_ENCRYPTION_KEY=una_clave_aleatoria_de_32_bytes_o_mas
ZEGOCLOUD_APP_ID=tu_app_id
ZEGOCLOUD_APP_SIGN=tu_app_sign
GIPHY_API_KEY=tu_giphy_key
